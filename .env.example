# =========================================================================
# AuraFashion Environment Configuration Template
# =========================================================================
# Copy this file to a new file named '.env' and populate the values.
# NEVER commit your actual '.env' file or keys to public version control!
# =========================================================================

# Google Gemini API Key (Required for Try-On and Sketch processing APIs)
# Get a key for free from: https://aistudio.google.com/
GEMINI_API_KEY=

# Port for the Node/Express backend server (Defaults to 3000)
PORT=3000

# Environment Mode (production / development)
NODE_ENV=development
